<?xml version="1.0" encoding="UTF-8"?>
<!--
  Global Maven settings for the Bootshift sandbox.
  Every repository, including ones a project declares itself, goes through the dependency proxy.
  The sandbox network has no other route out, so a project cannot fetch from anywhere else.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <localRepository>/m2/repository</localRepository>
  <interactiveMode>false</interactiveMode>
  <mirrors>
    <mirror>
      <id>bootshift-proxy</id>
      <name>Bootshift dependency proxy</name>
      <mirrorOf>*</mirrorOf>
      <url>${env.BOOTSHIFT_MAVEN_MIRROR}</url>
    </mirror>
  </mirrors>
</settings>
